module workspace_assumptions

// Generated by the acp_core policy compiler from policy "workspace". Do not edit.
//
// Application assumptions: invariants the application enforces over relationships, which acp_core does not.
// Use them to generate instances the application can actually produce: run { assumptions and ... }

open workspace

// a subject is never related to a doc through more than one of: owner, reviewer, banned
pred disjoint_doc_owner_reviewer_banned {
    no (Doc <: owner) & (Doc <: reviewer)
    no (Doc <: owner) & (Doc <: banned)
    no (Doc <: reviewer) & (Doc <: banned)
}

// a subject is never related to a group through more than one of: admin, member
pred disjoint_group_admin_member {
    no (Group <: admin) & (Group <: member)
}

// a doc has at most one folder
pred at_most_one_doc_folder {
    all o: Doc | lone o.folder
}

// following parent from a folder never leads back to it
pred acyclic_folder_parent {
    no o: Folder | o in o.^parent
}

// following member from a group never leads back to it
pred acyclic_group_member {
    no o: Group | o in o.^member_group_member
}

pred assumptions {
    disjoint_doc_owner_reviewer_banned
    disjoint_group_admin_member
    at_most_one_doc_folder
    acyclic_folder_parent
    acyclic_group_member
}
