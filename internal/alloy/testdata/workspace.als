module workspace

// Generated by the acp_core policy compiler from policy "workspace". Do not edit.

abstract sig Object {}

sig Actor {}

sig Doc extends Object {
    owner: one Actor,
    banned: set Actor,
    folder: set Folder,
    reviewer: set Actor,
}

sig Folder extends Object {
    owner: one Actor,
    editor: set Actor,
    editor_group_view: set Group,
    parent: set Folder,
    viewer: set Actor,
    viewer_group_member: set Group,
}

sig Group extends Object {
    owner: one Actor,
    admin: set Actor,
    member: set Actor,
    member_group_member: set Group,
}

// doc relations

fun doc_owner: Doc->Actor {
    (Doc <: owner)
}

fun doc_banned: Doc->Actor {
    banned
}

fun doc_folder: Doc->Actor {
    none->none
}

fun doc_reviewer: Doc->Actor {
    reviewer
}

// doc permissions

// review: (owner + (reviewer & folder->view))
fun doc_review: Doc->Actor {
    doc_owner + (doc_reviewer & folder.folder_view)
}

// view: (owner + (folder->view - banned))
fun doc_view: Doc->Actor {
    doc_owner + (folder.folder_view - doc_banned)
}

// folder relations

fun folder_owner: Folder->Actor {
    (Folder <: owner)
}

fun folder_editor: Folder->Actor {
    editor + editor_group_view.group_view
}

fun folder_parent: Folder->Actor {
    none->none
}

fun folder_viewer: Folder->Actor {
    viewer + viewer_group_member.group_member
}

// folder permissions

// edit: (owner + (editor + parent->edit))
fun folder_edit: Folder->Actor {
    (*parent).(folder_owner + folder_editor)
}

// view: (owner + ((viewer + edit) + parent->view))
fun folder_view: Folder->Actor {
    (*parent).(folder_owner + folder_viewer + folder_edit)
}

// group relations

fun group_owner: Group->Actor {
    (Group <: owner)
}

fun group_admin: Group->Actor {
    admin
}

fun group_member: Group->Actor {
    (*member_group_member).(member)
}

// group permissions

// view: (owner + (admin + member))
fun group_view: Group->Actor {
    group_owner + group_admin + group_member
}
